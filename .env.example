# ContriSkill shared defaults
# Copy values into app-specific .env.local files as needed.

# Global runtime
NODE_ENV=development
LOG_LEVEL=info

# API runtime (apps/api/.env.local)
API_PORT=4000
SESSION_TTL_MINUTES=30
WS_CORS_ORIGIN=http://localhost:3000

# Web runtime (apps/web/.env.local)
NEXT_PUBLIC_APP_NAME=ContriSkill
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Optional: if omitted, web derives ws(s)://<api-host>/api/v1/realtime
# NEXT_PUBLIC_REALTIME_URL=ws://localhost:4000/api/v1/realtime

# Optional local API auth/persistence keys (required in production)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/contriskill
# JWT_ACCESS_SECRET=replace-me
# JWT_REFRESH_SECRET=replace-me-too
