# Web environment template (local)
# Copy to: apps/web/.env.local

# Required
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional defaults
NEXT_PUBLIC_APP_NAME=ContriSkill
# If omitted, runtime derives ws(s) URL from NEXT_PUBLIC_API_BASE_URL:
# ws://localhost:4000/api/v1/realtime (or wss:// for https API URLs)
# NEXT_PUBLIC_REALTIME_URL=ws://localhost:4000/api/v1/realtime
