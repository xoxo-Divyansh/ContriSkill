# API environment template (local)
# Copy to: apps/api/.env.local

# Required in all environments
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
SESSION_TTL_MINUTES=30
WS_CORS_ORIGIN=http://localhost:3000

# Optional in local/dev (API falls back to stateless session runtime)
# Required in production
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/contriskill
# JWT_ACCESS_SECRET=replace-me
# JWT_REFRESH_SECRET=replace-me-too
