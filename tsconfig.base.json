{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@contriskill/contracts": ["packages/contracts/src/index.ts"],
      "@contriskill/domain": ["packages/domain/src/index.ts"],
      "@contriskill/config": ["packages/config/src/index.ts"],
      "@contriskill/utils": ["packages/utils/src/index.ts"],
      "@contriskill/ui": ["packages/ui/src/index.tsx"]
    }
  }
}
